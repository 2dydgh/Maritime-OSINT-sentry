# deploy/.env.prod.example — 프로덕션 환경변수 (값을 반드시 변경할 것)
AIS_API_KEY=your_ais_api_key_here
# 저사양 서버는 비워서 기본값(한국/동아시아 근해)을 쓸 것. 전세계는 2vCPU/2GB+ 권장.
AIS_BOUNDING_BOX=
DB_USER=osint_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432
DB_NAME=osint_4d
REDIS_URL=redis://redis:6379
METRICS_ENABLED=true

# 도메인 (없으면 IP 사용, Caddy auto-HTTPS 비활성화)
DOMAIN=your-domain.com

# Grafana
GRAFANA_ADMIN_PASSWORD=admin
