# .env.example — 비밀 값 없이 키만 정의. 복사해서 .env로 쓰세요.
#   cp .env.example .env  &&  값 채우기  &&  docker compose up -d --build

# --- 외부 API ---
AIS_API_KEY=your_ais_api_key_here
# AIS 구독 범위 "minLat,minLng,maxLat,maxLng". 비우면 한국/동아시아 근해로 제한됨
# (backend/config.py 기본값). 전세계로 받으려면 -90,-180,90,180 (저사양 서버 비추천).
AIS_BOUNDING_BOX=
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# --- DB (도커: 컨테이너가 이 값으로 초기화됨) ---
DB_USER=db_user
DB_PASSWORD=change_me_in_production
DB_NAME=osint_4d
# 로컬 직접 실행 시: DB_HOST=127.0.0.1 / DB_PORT=5432
# 도커 compose 내부에서는 app이 자동으로 DB_HOST=db 를 사용 (override 불필요)
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Redis ---
# 로컬: redis://localhost:6379 / 도커: app이 자동으로 redis://redis:6379 사용
REDIS_URL=redis://localhost:6379

# --- LLM (Ollama) ---
# 도커에서는 app이 자동으로 http://ollama:11434 사용. 모델 태그만 맞추면 됨.
# ⚠ OLLAMA_MODEL은 ollama 레지스트리에 실제 존재하는 태그여야 자동 pull 됨.
OLLAMA_MODEL=qwen3.5:9b

# --- 관측 ---
METRICS_ENABLED=true
